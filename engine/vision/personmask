#!/usr/bin/env python3
"""personmask (Linux stand-in): a person matte for every image, with Robust Video Matting through onnxruntime.
usage: personmask frame1.png frame2.png ... -> writes frameN.mask.png (8-bit gray, image size), prints `OK <out>` per image
       personmask --check
Same files as engine/swift/personmask on a Mac. The images of one call are treated as consecutive frames of one shot (the matte's
recurrent state carries across them), which is how the callers hand them over: the frames of one caption window, in order."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _shim  # noqa: E402

NAME = "personmask"


def main():
    args = sys.argv[1:]
    missing = _shim.reexec_if_missing(["onnxruntime", "numpy", "PIL"])
    if missing:
        _shim.fail(NAME, f"python cannot import {', '.join(missing)}: run install.sh (it puts onnxruntime in the word-timing environment)")
    import numpy as np
    import onnxruntime as ort
    from PIL import Image
    import _rvm
    model = _shim.model(*_shim.RVM, NAME)
    matter = _rvm.Matter(ort, model, "accurate")
    if args == ["--check"]:
        matter.alpha(np.zeros((96, 160, 3), np.uint8))
        _shim.ok(NAME, f"onnxruntime {ort.__version__}, Robust Video Matting {os.path.basename(model)}")
    for path in args:
        try:
            rgb = np.asarray(Image.open(path).convert("RGB"))
        except Exception as e:   # noqa: BLE001
            print(f"ERR {path} load {type(e).__name__}")
            continue
        out = path[:-4] + ".mask.png" if path.lower().endswith(".png") else path + ".mask.png"
        Image.fromarray(matter.alpha(rgb), "L").save(out)
        print(f"OK {out}")


if __name__ == "__main__":
    main()
