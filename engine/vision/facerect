#!/usr/bin/env python3
"""facerect (Linux stand-in): the largest face box per image, with OpenCV's YuNet detector.
usage: facerect img1.png img2.png ...   ->  one line per image: <path>\t<x>\t<y>\t<w>\t<h>  (pixels, top-left origin; "none" when no face)
       facerect --check               ->  `ok facerect: ...` or a STOP line
Same lines as engine/swift/facerect on a Mac. The model file is face_detection_yunet_2023mar.onnx in the models folder."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _shim  # noqa: E402

NAME = "facerect"


def main():
    args = sys.argv[1:]
    missing = _shim.reexec_if_missing(["cv2", "numpy"])
    if missing:
        _shim.fail(NAME, f"python cannot import {', '.join(missing)}: run install.sh (it puts opencv-python-headless in the word-timing environment)")
    import cv2
    import numpy as np
    model = _shim.model(*_shim.YUNET, NAME)
    if args == ["--check"]:
        det = _shim.yunet(cv2, model, 320, 240)
        det.detect(np.zeros((240, 320, 3), np.uint8))
        _shim.ok(NAME, f"OpenCV {cv2.__version__} YuNet, model {os.path.basename(model)}")
    det, size = None, None
    for path in args:
        img = _shim.imread(cv2, path)
        if img is None:
            print(f"{path}\tnone")
            continue
        H, W = img.shape[:2]
        if det is None or size != (W, H):
            det, size = _shim.yunet(cv2, model, W, H), (W, H)
        _, faces = det.detect(img)
        best = _shim.largest_face(faces)
        if best is None:
            print(f"{path}\tnone")
            continue
        x, y, w, h = _shim.clamp_box(float(best[0]), float(best[1]), float(best[2]), float(best[3]), W, H)
        print(f"{path}\t{int(x)}\t{int(y)}\t{int(w)}\t{int(h)}")


if __name__ == "__main__":
    main()
