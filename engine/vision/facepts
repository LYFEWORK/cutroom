#!/usr/bin/env python3
"""facepts (Linux stand-in): the largest face per image with its two eye centers, with OpenCV's YuNet detector and its landmarks.
usage: facepts img1.jpg img2.jpg ...   ->  one line per image: <path>\t<x>\t<y>\t<w>\t<h>\t<lx>\t<ly>\t<rx>\t<ry>   ("none" when no face)
       facepts --check
Pixels, top-left origin, two decimals. l is the eye on the image's left and r the one on the image's right: that is how the Apple helper's
leftEye and rightEye come out, measured side by side on the same frames (Vision names them from the viewer's side)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _shim  # noqa: E402

NAME = "facepts"


def main():
    args = sys.argv[1:]
    missing = _shim.reexec_if_missing(["cv2", "numpy"])
    if missing:
        _shim.fail(NAME, f"python cannot import {', '.join(missing)}: run install.sh (it puts opencv-python-headless in the word-timing environment)")
    import cv2
    import numpy as np
    model = _shim.model(*_shim.YUNET, NAME)
    if args == ["--check"]:
        det = _shim.yunet(cv2, model, 320, 240)
        det.detect(np.zeros((240, 320, 3), np.uint8))
        _shim.ok(NAME, f"OpenCV {cv2.__version__} YuNet landmarks, model {os.path.basename(model)}")
    det, size = None, None
    f = lambda v: f"{float(v):.2f}"  # noqa: E731
    for path in args:
        img = _shim.imread(cv2, path)
        if img is None:
            print(f"{path}\tnone")
            continue
        H, W = img.shape[:2]
        if det is None or size != (W, H):
            det, size = _shim.yunet(cv2, model, W, H), (W, H)
        _, faces = det.detect(img)
        best = _shim.largest_face(faces)
        if best is None:
            print(f"{path}\tnone")
            continue
        x, y, w, h = _shim.clamp_box(float(best[0]), float(best[1]), float(best[2]), float(best[3]), W, H)
        eyes = sorted([(float(best[4]), float(best[5])), (float(best[6]), float(best[7]))], key=lambda p: p[0])
        (lx, ly), (rx, ry) = eyes[0], eyes[1]   # l on the image's left, r on its right, as the Apple helper prints them
        print(f"{path}\t{f(x)}\t{f(y)}\t{f(w)}\t{f(h)}\t{f(lx)}\t{f(ly)}\t{f(rx)}\t{f(ry)}")


if __name__ == "__main__":
    main()
