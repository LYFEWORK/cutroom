{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DNA",
  "description": "One Brand/dna.json. Every object is closed (additionalProperties false), so a typo fails the check. Asset paths are relative to Brand/assets/, except music.library, which is relative to Brand/. A string that still says TODO is a problem wherever it sits. The keyword why is a note appended to a range or pattern problem.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "colors", "fonts", "output"],
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "id": {"$ref": "#/definitions/id", "why": "lowercase letters, digits and dashes"},
    "name": {"type": "string", "minLength": 1},
    "handle": {"type": "string", "pattern": "^(@[A-Za-z0-9._]+)?$", "why": "an @name, or empty"},
    "site": {"type": "string"},
    "people": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {
      "name": {"type": "string", "minLength": 1},
      "role": {"type": "string"},
      "name_tag": {"type": "boolean"}}}},
    "colors": {"type": "object", "additionalProperties": false, "required": ["ink", "base", "accent", "on_accent", "negative", "bg", "card"], "properties": {
      "ink": {"$ref": "#/definitions/hex"},
      "base": {"$ref": "#/definitions/hex"},
      "accent": {"$ref": "#/definitions/hex"},
      "on_accent": {"$ref": "#/definitions/hex"},
      "negative": {"$ref": "#/definitions/hex"},
      "bg": {"$ref": "#/definitions/hex"},
      "card": {"$ref": "#/definitions/hex"}}},
    "surface": {"type": "object", "additionalProperties": false, "properties": {
      "background": {"type": "string", "minLength": 1},
      "border": {"type": "string"}}},
    "fonts": {"type": "object", "additionalProperties": false, "required": ["display"], "properties": {
      "display": {"$ref": "#/definitions/fontface", "type": "object"},
      "running": {"$ref": "#/definitions/fontface"},
      "mono": {"$ref": "#/definitions/fontface"}}},
    "type": {"type": "object", "additionalProperties": false, "properties": {
      "caps": {"type": "boolean"},
      "skew": {"type": "number", "minimum": -30, "maximum": 30}}},
    "logo": {"type": "object", "additionalProperties": false, "properties": {
      "emblem": {"$ref": "#/definitions/assetOrNull"},
      "lockup": {"$ref": "#/definitions/assetOrNull"},
      "lockup_dark": {"$ref": "#/definitions/assetOrNull"}}},
    "captions": {"type": "object", "additionalProperties": false, "properties": {
      "case": {"type": "string", "enum": ["upper", "mixed", "title"]},
      "zone": {"type": "string", "enum": ["top", "chest"]},
      "width": {"type": "integer", "minimum": 300, "maximum": 1080},
      "top_y0": {"type": "integer", "minimum": 0, "maximum": 1920},
      "hero_max": {"type": "integer", "minimum": 50, "maximum": 800},
      "row_px": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 20, "maximum": 400}},
      "chin_gap": {"type": "integer", "minimum": 0, "maximum": 600},
      "chip": {"type": "boolean"},
      "hero_base": {"$ref": "#/definitions/hexOrNull"},
      "hero_shadow": {"type": "string"},
      "hero_stroke": {"$ref": "#/definitions/stroke"},
      "text_opacity": {"type": "number", "minimum": 0, "maximum": 1},
      "text_soften": {"type": "number", "minimum": 0, "maximum": 20},
      "whip_frames": {"type": "integer", "minimum": 0, "maximum": 30},
      "whip_amount": {"type": "number", "minimum": 0, "maximum": 1},
      "caption_tier_max": {"type": "string", "enum": ["MINIMAL", "REDUCED", "FULL"]},
      "soft_build": {"type": "boolean"},
      "default_style": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "why": "a style id (lower case words joined by hyphens), or null for the brand's own preset"},
      "pace_gate": {"type": "string", "enum": ["off", "report", "enforce"]},
      "hero_glow": {"type": "boolean"},
      "hero_tint": {"$ref": "#/definitions/hexOrNull"},
      "glow_px": {"type": "integer", "minimum": 0, "maximum": 80},
      "chip_neg": {"$ref": "#/definitions/hexOrNull"},
      "neg_words": {"$ref": "#/definitions/words"},
      "count_up": {"type": "boolean"},
      "places": {"$ref": "#/definitions/words"},
      "cta_wash": {"$ref": "#/definitions/hexOrNull"},
      "page_bg": {"$ref": "#/definitions/hexOrNull"},
      "page_ink": {"$ref": "#/definitions/hexOrNull"},
      "display_weight": {"type": "integer", "minimum": 100, "maximum": 900},
      "pill_bg": {"$ref": "#/definitions/hexOrNull"},
      "pill_ink": {"$ref": "#/definitions/hexOrNull"},
      "icon_words": {"$ref": "#/definitions/words"},
      "pill_icons": {"$ref": "#/definitions/words"},
      "feel": {"type": "string"},
      "look_note": {"type": "string"},
      "text_hook": {"type": "string", "enum": ["on", "off"]}}},
    "feed_captions": {"type": "object", "additionalProperties": false, "properties": {
      "words_per_page": {"type": "integer", "minimum": 1, "maximum": 3},
      "size_px": {"type": "integer", "minimum": 40, "maximum": 140},
      "stroke_px": {"type": "number", "minimum": 0, "maximum": 20},
      "top_px": {"type": "integer", "minimum": 0, "maximum": 1920}}},
    "hook": {"type": "object", "additionalProperties": false, "properties": {
      "on": {"type": "boolean"},
      "look": {"type": "string", "enum": ["card", "accent", "ink", "bigtype", "bar", "mono"]},
      "top_px": {"type": "integer", "minimum": 220, "maximum": 1600, "why": "the platform's own header covers the top 220 px of a 1080 x 1920 frame"},
      "size_px": {"type": ["integer", "null"], "minimum": 40, "maximum": 120},
      "font": {"type": "string", "enum": ["display", "running"]},
      "hold_s": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 1, "maximum": 15}}}},
    "formats": {"type": "object", "additionalProperties": false, "properties": {
      "home": {"$ref": "#/definitions/id"},
      "list": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/id"}}}},
    "motion": {"type": "object", "additionalProperties": false, "properties": {
      "level": {"type": "string", "enum": ["face", "light", "full"]},
      "transitions_allowed": {"$ref": "#/definitions/words"},
      "transitions_banned": {"$ref": "#/definitions/words"},
      "punches": {"type": "boolean"},
      "auto_punches": {"type": "boolean"},
      "smooth": {"type": "boolean"},
      "energy": {"type": "integer", "minimum": 1, "maximum": 5}}},
    "graphics": {"type": "object", "additionalProperties": false, "properties": {
      "wishlist": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "priority"], "properties": {
        "id": {"$ref": "#/definitions/id"},
        "name": {"type": "string", "minLength": 1},
        "what": {"type": "string"},
        "priority": {"type": "string", "enum": ["must", "later"]},
        "from_study": {"type": ["string", "null"]}}}},
      "built": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "component"], "properties": {
        "id": {"$ref": "#/definitions/id"},
        "component": {"type": "string", "minLength": 1},
        "since": {"$ref": "#/definitions/date"}}}}}},
    "broll": {"type": "object", "additionalProperties": false, "properties": {
      "style": {"type": "string", "enum": ["cut", "dynamic"]},
      "hold_min_s": {"type": "number", "minimum": 0.3, "maximum": 30},
      "hold_max_s": {"type": "number", "minimum": 0.3, "maximum": 30},
      "own_footage_floor": {"type": "number", "minimum": 0, "maximum": 1},
      "ai": {"type": "string", "enum": ["objects-and-places", "off"]}}},
    "music": {"type": "object", "additionalProperties": false, "properties": {
      "on_talking_head": {"type": "boolean"},
      "on_montage": {"type": "boolean"},
      "feel": {"type": "string"},
      "alone_lufs": {"type": "number", "minimum": -40, "maximum": -6},
      "under_speech_db": {"type": "number", "minimum": 0, "maximum": 60},
      "alone_db": {"type": "number", "minimum": 0, "maximum": 60},
      "ease_s": {"type": "number", "minimum": 0, "maximum": 5},
      "library": {"$ref": "#/definitions/relpath"},
      "repeat_gap_videos": {"type": "integer", "minimum": 0, "maximum": 50},
      "banned_md5": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{32}$", "why": "32 lowercase hex characters"}}}},
    "sound": {"type": "object", "additionalProperties": false, "properties": {
      "sfx": {"type": "string", "enum": ["clicks", "off"]},
      "sfx_per_min": {"type": "integer", "minimum": 0, "maximum": 60},
      "sfx_under_speech_db": {"type": "number", "minimum": 0, "maximum": 40},
      "voice_isolation_pct": {"type": "integer", "minimum": 0, "maximum": 100},
      "master_lufs": {"type": "number", "minimum": -30, "maximum": -6},
      "true_peak_dbtp": {"type": "number", "minimum": -9, "maximum": 0},
      "profanity": {"type": "string", "enum": ["spoken", "bleep", "cut"]}}},
    "words": {"type": "object", "additionalProperties": false, "properties": {
      "spelling": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
      "banned": {"$ref": "#/definitions/words"}}},
    "grade": {"type": "object", "additionalProperties": false, "properties": {
      "enabled": {"type": "boolean"},
      "lut": {"$ref": "#/definitions/assetOrNull"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["aspect", "size"], "properties": {
      "aspect": {"$ref": "#/definitions/aspect"},
      "size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 240, "maximum": 4320}},
      "fps": {"type": "integer", "minimum": 12, "maximum": 120},
      "crf": {"type": "integer", "minimum": 8, "maximum": 28},
      "also": {"type": "array", "items": {"$ref": "#/definitions/aspect"}}}},
    "delivery": {"type": "object", "additionalProperties": false, "properties": {
      "end_card": {"type": "object", "additionalProperties": false, "properties": {
        "on": {"type": "boolean"},
        "line": {"type": "string"},
        "handle": {"type": "string", "pattern": "^(@[A-Za-z0-9._]+)?$", "why": "an @name, or empty for the brand's handle"}}},
      "transcript": {"type": "boolean"},
      "caption_file": {"type": "boolean"}}},
    "review": {"type": "object", "additionalProperties": false, "properties": {
      "keep_cut_on_intake": {"type": "boolean"},
      "approve_before_render": {"type": "boolean"}}},
    "cleanup": {"type": "object", "additionalProperties": false, "properties": {
      "after_delivery": {"type": "string", "enum": ["ask", "auto"]},
      "keep": {"type": "array", "items": {"$ref": "#/definitions/id"}}}},
    "storage": {"type": "object", "additionalProperties": false, "properties": {
      "archive": {"type": "string"},
      "warn_free_gb": {"type": "number", "minimum": 0, "maximum": 100000}}},
    "pacing": {"type": "object", "additionalProperties": false, "properties": {
      "cuts_per_min": {"type": ["number", "null"], "minimum": 0, "maximum": 300},
      "median_shot_s": {"type": ["number", "null"], "minimum": 0, "maximum": 120},
      "text_on_screen_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100}}},
    "studies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["slug"], "properties": {
      "slug": {"$ref": "#/definitions/id"},
      "url": {"type": "string"},
      "date": {"$ref": "#/definitions/date"},
      "liked": {"type": "string"},
      "adopted": {"$ref": "#/definitions/words"}}}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "hexOrNull": {"type": ["string", "null"], "pattern": "^#[0-9A-Fa-f]{6}$"},
    "relpath": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\s].*$", "why": "a path inside the folder, with no leading / and no .."},
    "assetOrNull": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*\\.\\.)[^\\s].*$", "why": "a path inside Brand/assets/, with no leading / and no .., or null"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "why": "YYYY-MM-DD"},
    "aspect": {"type": "string", "enum": ["9:16", "4:5", "1:1", "16:9"]},
    "words": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stroke": {"type": ["object", "null"], "additionalProperties": false, "required": ["width", "color"], "properties": {
      "width": {"type": "integer", "minimum": 0, "maximum": 40},
      "color": {"$ref": "#/definitions/hex"}}},
    "fontface": {"type": ["object", "null"], "additionalProperties": false, "required": ["family", "file"], "properties": {
      "family": {"type": "string", "minLength": 1},
      "file": {"$ref": "#/definitions/relpath"},
      "weights": {"type": "object", "additionalProperties": false, "patternProperties": {"^[1-9]00$": {"$ref": "#/definitions/relpath"}}},
      "fallback": {"type": "string"}}}
  }
}
